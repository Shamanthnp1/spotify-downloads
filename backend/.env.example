# ─── Upstash Redis ────────────────────────────────────────────────────────────
# Full Redis connection URL from Upstash dashboard.
# Format: rediss://default:<password>@<host>:<port>
# Used by both Flask-Limiter, Celery broker, and job status storage.
REDIS_URL=REDIS_URL="rediss://default:gQAAAAAAAXNPAAIgcDFlNDEwMGU2M2ZmMWQ0ZmU0ODAyZmY2NjA2ODIyNzkyNA@ready-hookworm-95055.upstash.io:6379"

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
# Account-specific R2 S3-compatible endpoint.
# Format: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=https://b48bb45cf67ef32110d029f29361f753.r2.cloudflarestorage.com

# R2 API token Access Key ID (from Cloudflare dashboard → R2 → Manage API Tokens)
R2_ACCESS_KEY_ID=7162905ffbbadf5492634ff6ef0ee97b

# R2 API token Secret Access Key
R2_SECRET_ACCESS_KEY=5c3e32d5bc400f397747476de45fe66668fc2a23c6057eb5da078f321a07b0c0

# Name of the R2 bucket where downloaded files are stored
R2_BUCKET_NAME=spotify-downloads

# ─── Flask / CORS ─────────────────────────────────────────────────────────────
# Full URL of the Vercel frontend deployment (no trailing slash).
# Used to restrict CORS to your domain only.
# Example: https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# ─── Container Mode ───────────────────────────────────────────────────────────
# Controls which process the Docker container runs.
# "web"    → runs gunicorn (Flask API server)
# "worker" → runs Celery worker
# Set this per container in your Azure Container Apps environment.
COMMAND=web
